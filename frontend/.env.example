# Optional. If unset:
#   - `npm run dev` uses Vite proxy → http://127.0.0.1:8000 (no CORS issues)
#   - production build defaults to http://localhost:8000/api (usually wrong for hosting)
# VITE_API_BASE_URL=http://localhost:8000/api

# GitHub Actions → Settings → Secrets: set VITE_API_BASE_URL to your deployed API
# (e.g. https://your-api.example.com/api) so the Pages site can log in.

# Local demo login (after: python manage.py create_default_user)
# username: demo
# password: demo1234  (override with DJANGO_DEFAULT_USER_PASSWORD on backend)
